# Переменные фронтенда. Vite подставляет их на этапе сборки —
# после правки нужен повторный `npm run build`.

# Google OAuth client id (тот же, что GOOGLE_CLIENT_ID у бэкенда)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Адрес API.
#
# В ПРОДЕ: VITE_API_URL=/api
# Относительный путь — осознанное решение: бандл не привязан к домену, фронт стучится
# на тот же хост, с которого отдан, а Nginx проксирует /api/ на бэкенд. Не меняйте на
# абсолютный URL — это вернёт домен внутрь собранного бандла.
#
# ЛОКАЛЬНО: фронт (:5173) и бэкенд (:3001) на разных портах, поэтому нужен полный адрес.
VITE_API_URL=http://localhost:3001/api
