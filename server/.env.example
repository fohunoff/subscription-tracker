# Google OAuth — тот же client id, что и VITE_GOOGLE_CLIENT_ID у фронта.
# Домен приложения должен быть в Authorized JavaScript origins в Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Secret — обязателен, сервер не стартует без него (fallback-ключа больше нет).
# Смена значения инвалидирует все выданные токены: пользователям придётся войти заново.
JWT_SECRET=your_jwt_secret_here

# MongoDB
# В проде: mongodb://fohunoff:<пароль>@127.0.0.1:27017/subscription-tracker?authSource=admin
MONGODB_URI=mongodb://localhost:27017/subscription-tracker

# Server
# В проде PORT=5000 — именно туда Nginx проксирует /api/
PORT=3001
NODE_ENV=development

# CORS: origin фронтенда. Можно перечислить несколько через запятую.
# В проде: FRONTEND_URL=https://tracker.fohunoff.com
FRONTEND_URL=http://localhost:5173

# Telegram Bot (опционально)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
